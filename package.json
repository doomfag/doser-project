{
  "name": "doser",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src/test server",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "start": "node --use-env-proxy server/index.ts",
    "catalog:update": "node --use-env-proxy server/update.ts",
    "build:portable": "npm run build && node scripts/portable.ts",
    "test:release": "node scripts/verify-release.ts",
    "native:prepare": "npm run build && node scripts/prepare-native.ts",
    "desktop:dev": "npm run native:prepare && electron .",
    "desktop:build": "npm run native:prepare && electron-builder --publish never",
    "android:prepare": "npm run native:prepare && node scripts/portable.ts mobile/www/index.html --native-json && node scripts/android.ts",
    "test:desktop": "node scripts/smoke-desktop.ts",
    "ios:prepare": "npm run native:prepare && node scripts/portable.ts mobile/www/index.html --native-json && node scripts/ios.ts",
    "android:tv:prepare": "npm run native:prepare && node scripts/portable.ts mobile/www/index.html --native-json --tv && node scripts/android.ts --tv",
    "tv:prepare": "npm run native:prepare && node scripts/prepare-tv.ts",
    "test:tv": "node scripts/verify-tv.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "csv-parse": "^7.0.3",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "main": "desktop/main.cjs",
  "description": "Consulta farmacol\u00f3gica pessoal com cat\u00e1logo local",
  "author": "Doser",
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "desktopName": "doser.desktop"
}
