{
  "name": "doser",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-env-proxy node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src/test server",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "start": "node --use-env-proxy server/index.ts",
    "catalog:update": "node --use-env-proxy server/update.ts",
    "build:portable": "npm run build && node scripts/portable.ts",
    "test:release": "node scripts/verify-release.ts"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.5.0"
  }
}
